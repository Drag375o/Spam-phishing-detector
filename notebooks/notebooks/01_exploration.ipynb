   "source": [
    "import pandas as pd\n",
    "import os\n",
    "\n",
    "RAW = \"../data/raw\"\n",
    "\n",
    "for f in sorted(os.listdir(RAW)):\n",
    "    if not f.endswith(\".csv\"):\n",
    "        continue\n",
    "    df = pd.read_csv(os.path.join(RAW, f), nrows=3)\n",
    "    print(f\"\\n=== {f} ===\")\n",
    "    print(\"Columns:\", list(df.columns))"
   ]
  }
